# --- Required for live scanning ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DISCORD_WEBHOOK_URL=
OPENAI_API_KEY=

# Railway provides this automatically when Postgres is attached.
DATABASE_URL=sqlite:///./scanner.db

# --- Scanner ---
MIN_PRICE=5
MIN_DOLLAR_VOLUME=5000000
PREFILTER_LIMIT=60
TECHNICAL_LIMIT=20
RESEARCH_LIMIT=8
MIN_ENTRY_SCORE=80
HIGH_CONVICTION_SCORE=90
SCAN_INTERVAL_MINUTES=5
RESEARCH_CACHE_MINUTES=30
MAX_RISK_DOLLARS=100

# --- Behavior ---
TRADINGAGENTS_ENABLED=true
SEND_WATCH_ALERTS=true
SEND_STATUS_ALERTS=true
DRY_RUN=false
TIMEZONE=America/New_York
