# --- Required for live scanning ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
DISCORD_WEBHOOK_URL=
OPENAI_API_KEY=

# Railway provides this automatically when Postgres is attached.
DATABASE_URL=sqlite:///./scanner.db

# --- Scanner ---
MIN_PRICE=5
MIN_DOLLAR_VOLUME=5000000
PREFILTER_LIMIT=60
TECHNICAL_LIMIT=20
RESEARCH_LIMIT=8
MIN_ENTRY_SCORE=80
HIGH_CONVICTION_SCORE=90
SCAN_INTERVAL_MINUTES=5
RESEARCH_CACHE_MINUTES=30
MAX_RISK_DOLLARS=100

# --- Behavior ---
TRADINGAGENTS_ENABLED=true
SEND_WATCH_ALERTS=true
SEND_STATUS_ALERTS=true
DRY_RUN=false
TIMEZONE=America/New_York

# --- Meme discovery (manual execution in Fomo only) ---
MEME_ENABLED=true
MEME_SCAN_INTERVAL_MINUTES=10
MEME_CANDIDATE_LIMIT=40
MEME_ALERT_LIMIT=5
MEME_MIN_ALERT_SCORE=72
MEME_HIGH_CONVICTION_SCORE=82
MEME_MIN_LIQUIDITY_USD=50000
MEME_MIN_VOLUME_1H_USD=25000
MEME_MIN_TXNS_1H=40
MEME_B_SIZE_DOLLARS=10
MEME_A_SIZE_DOLLARS=20
MEME_STOP_PCT=15
MEME_TARGET1_PCT=25
MEME_TARGET2_PCT=50
FOMO_APP_URL=https://fomo.family/
CRYPTO_DISCORD_WEBHOOK_URL=
